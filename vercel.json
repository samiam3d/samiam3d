{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm --filter @workspace/samiam3d build",
  "outputDirectory": "artifacts/samiam3d/dist/public",
  "rewrites": [
    {
      "source": "/games",
      "destination": "/games/index.html"
    },
    {
      "source": "/games/",
      "destination": "/games/index.html"
    }
  ]
}
